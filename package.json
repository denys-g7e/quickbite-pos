{
  "name": "quickbite-pos",
  "version": "2.0.0",
  "description": "QuickBite POS - Sistema de Punto de Venta para restaurantes de comida rápida",
  "author": "QuickBite Systems",
  "license": "MIT",
  "main": "electron/dist/main.js",
  "scripts": {
    "dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "vite build && tsc -p electron/tsconfig.json",
    "dist": "npm run build && electron-builder --win --config",
    "dist:portable": "npm run build && electron-builder --win portable --config",
    "dist:installer": "npm run build && electron-builder --win nsis --config",
    "dist:all": "npm run build && electron-builder --win --config",
    "dist:mac": "npm run build && electron-builder --mac"
  },
  "build": {
    "appId": "com.quickbite.pos",
    "productName": "QuickBite POS",
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "files": [
      "electron/dist/**/*",
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/",
        "to": "resources/",
        "filter": [
          "**/*",
          "!generate-icon.ps1"
        ]
      }
    ],
    "extraMetadata": {
      "main": "electron/dist/main.js"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}.${ext}",
      "requestExecutionLevel": "user"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "QuickBite POS",
      "license": "LICENSE.txt",
      "runAfterFinish": true
    },
    "asar": true,
    "compression": "maximum"
  },
  "dependencies": {
    "adm-zip": "^0.5.17",
    "bcrypt": "^5.1.1",
    "better-sqlite3": "^9.4.3",
    "clsx": "^2.1.0",
    "date-fns": "^3.3.0",
    "drizzle-orm": "^0.30.0",
    "electron-pos-printer": "^1.2.0",
    "exceljs": "^4.4.0",
    "html-pdf-node": "^1.0.8",
    "lucide-react": "^0.383.0",
    "nodemailer": "^9.0.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.22.0",
    "recharts": "^2.12.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/better-sqlite3": "^7.6.8",
    "@types/node": "^26.0.0",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^18.2.55",
    "@types/react-dom": "^18.2.19",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.17",
    "concurrently": "^8.2.2",
    "electron": "^28.3.0",
    "electron-builder": "^24.13.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "vite": "^5.1.3",
    "vite-plugin-electron": "^0.28.4",
    "wait-on": "^7.2.0"
  }
}
